+func TestInFlightSuccessDoesNotClearCooldown(t *testing.T) {
+	reg := NewRegistry(nil, nil)
+	reg.SetPolicy(1, 5*time.Minute)
+	if !reg.Trip(1, "status 429", false) {
+		t.Fatal("429 should open the breaker")
+	}
+	reg.Pass(1) // a successful request that started before the 429
+	if !reg.IsOpen(1) {
+		t.Fatal("in-flight success cleared the active cooldown")
+	}
+	reg.Restore(1, State{Trips: 1, OpenUntil: time.Now().Add(-time.Second)})
+	reg.Pass(1)
+	if st := reg.Get(1); st.Trips != 0 || !st.OpenUntil.IsZero() {
+		t.Fatalf("expired cooldown was not cleared: %+v", st)
+	}
+}
